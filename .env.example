# EasyBrandsBackend — read-side API for the easybrands catalog.
# Copy to .env and adjust. JSONL-first always; Atlas is an optional read mirror.

PORT=8787
HOST=127.0.0.1

# Durable product ground-truth artifact (JSONL, one doc per product).
# Written by Phase 6.7→6.8 (collect_brand_products.py) — 5,475 docs @ ~11 MB.
DATA_FILE=../data/raw_products.jsonl

# Atlas (allow-listed ONLY from your machine — set the same MONGO_URI that
# collect_brand_products.py uses). When reachable, the API verifies the
# in-memory index against easybrands.products doc-count and logs it; reads
# stay in-memory so every query returns in <5 ms regardless of Atlas state.
ATLAS=auto          # auto | off
MONGO_URI=
MONGO_DB= easybrands
MONGO_COLLECTION= products

# Politeness / safety
SEED=../brands_seed.csv
REQUEST_LOG=true

# GPT chat assistant. The key is read only by this API and is never sent to the
# mobile app — the app talks to /api/v1/chat and nothing else.
# Leave GEMINI_API_KEY empty to run with the chat endpoint disabled (503).
GEMINI_API_KEY=
GEMINI_BASE_URL= https://generativelanguage.googleapis.com/v1beta
CHAT_MODEL= gemini-3.8-flash
# Per-client request cap, because each call is billable.
CHAT_RATE_LIMIT= 20
CHAT_RATE_WINDOW_MS= 60000

# --- Vercel (Dashboard > Project > Settings > Environment Variables) ---------
# Nothing above is read on Vercel: `.env` is gitignored and .vercelignore keeps
# it off the upload, so set these per environment (Production/Preview/Dev).
# Required:
#   MONGO_URI, MONGO_DB, MONGO_COLLECTION   catalogue (Vercel egress IPs must be
#                                           in the Atlas network access list)
#   GEMINI_API_KEY                          chat prose (503 if missing)
# Optional: DATA_FILE (unused — no JSONL on Vercel), CHAT_MODEL, CHAT_RATE_LIMIT,
#           CHAT_RATE_WINDOW_MS, REQUEST_LOG, TRUST_PROXY.
# VERCEL=1 is set by the platform and defaults TRUST_PROXY to 1, so the chat
# rate limiter keys on the client IP instead of Vercel's proxy IP.
