{
  "name": "easybrands-backend",
  "version": "0.1.0",
  "description": "Read-side API for the easybrands catalog: 5,475 enriched Pakistani clothing products keyed by (brand, website, handle) slug + category/tag browse + token search. JSONL-first in-memory (fast), Atlas-graceful.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "check:taxonomy": "tsx scripts/check-category-taxonomy.ts"
  },
  "dependencies": {
    "express": "^4.21.2",
    "mongodb": "^6.21.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.3",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}
